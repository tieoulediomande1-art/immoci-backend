# Copiez ce fichier en ".env" et remplissez vos propres valeurs.
# NE JAMAIS committer le fichier ".env" réel dans un dépôt public.

# Port sur lequel le serveur écoute (Render/Railway définissent souvent PORT automatiquement)
PORT=4000

# Clé secrète utilisée pour signer les tokens de connexion (JWT).
# Générez une chaîne aléatoire longue, par exemple avec : openssl rand -hex 32
JWT_SECRET=change_this_to_a_long_random_secret_string

# Identifiants du compte administrateur créé automatiquement au premier démarrage.
# Changez le mot de passe avant toute mise en ligne réelle !
ADMIN_USERNAME=admin
ADMIN_PASSWORD=immoci2024

# Domaine(s) autorisés à appeler cette API (le site qui consomme l'API).
# Utilisez "*" en développement, puis restreignez en production, ex: https://monsite.com
CORS_ORIGIN=*
